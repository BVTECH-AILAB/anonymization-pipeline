# Copy to .env. Used by `just dev` / `just start` (service on the host)
# and as overrides for docker-compose.yml. Never commit .env.

# --- Service (prefix ANONPIP_) ---
ANONPIP_ENVIRONMENT=local            # local | staging | prod (default prod if unset)
ANONPIP_LOG_LEVEL=DEBUG              # forced to INFO when environment=prod
ANONPIP_EXTENDED_LOG_CONTEXT=false   # user text in logs; ignored when environment=prod
ANONPIP_LOG_MASK_PREFIX=1
ANONPIP_LOG_MASK_SUFFIX=1

# --- Models (both run in other services: nothing is loaded in this one) ---
ANONPIP_PRELOAD_MODELS=true          # /readyz is 503 until the OCR server and the NER service answer (retried every 30 s)
# OCR server of ocr-server/. Keep it empty: compose uses http://paddle-ocr:8829, `just start`
# and `just evaluate` use http://127.0.0.1:8829. Only `just dev` needs it set (same local URL).
ANONPIP_OCR_SERVER_URL=
ANONPIP_OCR_DPI=300                  # resolution of the pages sent to OCR
ANONPIP_NER_ENABLED=true             # false: rules only, no NER (local tests only)
# AILAB NER service, staging (VPN). Plain http: the text of each page travels unencrypted, fine
# only with the synthetic dataset. The https endpoint needs its CA in ANONPIP_NER_CA_BUNDLE.
# Empty = /readyz 503.
ANONPIP_NER_URL=http://ner.agenas-stg.oci
ANONPIP_NER_TIMEOUT_SECONDS=30               # API; just evaluate / eval-ui use EVAL_NER_TIMEOUT_SECONDS (120)
ANONPIP_NER_RETRIES=2                        # retries on timeout, connection error, 502/503/504
ANONPIP_NER_RETRY_BACKOFF_SECONDS=1          # first wait, doubled at each retry
# ANONPIP_NER_CA_BUNDLE: PEM of the internal CA; empty = system CAs
ANONPIP_NER_CA_BUNDLE=
ANONPIP_NER_THRESHOLD=0.5
ANONPIP_NER_PERSON_THRESHOLD=0.4

# --- Jobs and limits ---
ANONPIP_MAX_UPLOAD_MB=30
ANONPIP_MAX_PAGES=50
ANONPIP_JOB_TTL_MINUTES=30           # documents are deleted after this time
ANONPIP_MAX_JOBS=20
# ANONPIP_WORK_DIR: empty = private temp folder
ANONPIP_WORK_DIR=

# --- Redaction policy ---
ANONPIP_REDACT_CLINICAL_DATES=false  # quasi-identifiers: detected, kept by default
ANONPIP_REDACT_AGE=false
ANONPIP_REDACT_ORGANIZATIONS=false
ANONPIP_REDACTION_STYLE=black        # black | label
ANONPIP_VERIFY_PIXEL_TOLERANCE=0.0002

# --- OCR server (ocr-server/, prefix OCRSRV_): read by compose; `just start` runs it on the host ---
# OCR_EXTRA: cpu | gpu (CUDA 12 wheels); empty: compose builds cpu, `just start` picks gpu when nvidia-smi is found
OCR_EXTRA=
OCRSRV_LOG_LEVEL=INFO
OCRSRV_DEVICE=auto                   # auto | gpu | cpu
OCRSRV_DET_MODEL=PP-OCRv5_server_det # PP-OCRv5_server_det | PP-OCRv5_mobile_det
OCRSRV_MARGIN_PT=60                  # side strips read again rotated (vertical text); 0 = off
OCRSRV_MARGIN_MIN_SCORE=0.5          # margin words below this confidence are dropped
OCRSRV_MAX_UPLOAD_MB=40
OCRSRV_GPU_MEM_LIMIT_MB=0            # memory cap of each model on the GPU; 0 = none (peak about 4 GB per page)
# OCRSRV_MODEL_DIR: empty: RapidOCR cache (compose: /models/rapidocr, about 90 MB on first start)
OCRSRV_MODEL_DIR=

# --- Local compose and `just start` only ---
APP_PORT=8000
OCR_PORT=8829
# demo page (apps/web, nginx in front of the API): http://127.0.0.1:8080
WEB_PORT=8080
