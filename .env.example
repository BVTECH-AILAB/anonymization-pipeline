# Copy to .env. Used by `just dev` (service on the host, DB in compose)
# and as overrides for docker-compose.yml. Never commit .env.

# --- Service (prefix TEMPLATE_) ---
TEMPLATE_ENVIRONMENT=local            # local | staging | prod (default prod if unset)
TEMPLATE_LOG_LEVEL=DEBUG              # forced to INFO when environment=prod
TEMPLATE_EXTENDED_LOG_CONTEXT=false   # user text in logs; ignored when environment=prod
TEMPLATE_LOG_MASK_PREFIX=1
TEMPLATE_LOG_MASK_SUFFIX=1
# In k8s this comes from the CNPG secret <cluster>-app, key "uri".
TEMPLATE_DATABASE_URL=postgresql://app:app@localhost:5433/app
TEMPLATE_DB_POOL_SIZE=5
TEMPLATE_DB_MAX_OVERFLOW=5
TEMPLATE_DB_CONNECT_TIMEOUT=5
TEMPLATE_RUN_MIGRATIONS=true          # read by scripts/entrypoint.sh

# --- Local compose only ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5433
APP_PORT=8000
