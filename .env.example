# Copy to .env. Overrides for docker-compose.yml and `just start`. The settings of each
# service are in its own .env.example (backend/, ocr-server/). Never commit .env.

# --- OCR server image built by compose ---
# OCR_EXTRA: cpu | gpu (CUDA 12 wheels); empty: compose builds cpu, `just start` picks gpu when nvidia-smi is found
OCR_EXTRA=

# --- Local compose only ---
APP_PORT=8000
OCR_PORT=8829
