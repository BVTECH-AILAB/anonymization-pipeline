# Copy to .env. Used by `just dev` (service on the host) and as overrides
# for docker-compose.yml. Never commit .env.

# --- Service (prefix ANONPIP_) ---
ANONPIP_ENVIRONMENT=local            # local | staging | prod (default prod if unset)
ANONPIP_LOG_LEVEL=DEBUG              # forced to INFO when environment=prod
ANONPIP_EXTENDED_LOG_CONTEXT=false   # user text in logs; ignored when environment=prod
ANONPIP_LOG_MASK_PREFIX=1
ANONPIP_LOG_MASK_SUFFIX=1
ANONPIP_PIPELINE_CONFIG_FILE=        # YAML with the pipeline keys to change; empty = packaged defaults
ANONPIP_MAX_UPLOAD_MB=30
ANONPIP_MAX_QUEUED_JOBS=20           # waiting or running; then 429
ANONPIP_MAX_KEPT_JOBS=50             # finished jobs kept in memory, the oldest go first
ANONPIP_JOB_TTL_S=1800               # a finished job (and its file) is deleted after this
ANONPIP_VAULT_KEY=                   # credential: key of the pseudonym maps (only for mode=pseudonym)

# --- Local compose only ---
APP_PORT=8000
