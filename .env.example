# Copy to .env. Used by `just dev` (service on the host) and as overrides
# for docker-compose.yml. Never commit .env.

# --- Service (prefix ANONPIP_) ---
ANONPIP_ENVIRONMENT=local            # local | staging | prod (default prod if unset)
ANONPIP_LOG_LEVEL=DEBUG              # forced to INFO when environment=prod
ANONPIP_EXTENDED_LOG_CONTEXT=false   # user text in logs; ignored when environment=prod
ANONPIP_LOG_MASK_PREFIX=1
ANONPIP_LOG_MASK_SUFFIX=1

# --- VLM backend (local: documents never leave the deployment) ---
ANONPIP_VLM_BACKEND=ollama           # ollama | openai (vLLM, llama.cpp: OpenAI-compatible API)
ANONPIP_VLM_URL=http://ollama:11434  # `just dev` on the host: the compose Ollama has no published port
ANONPIP_VLM_API_KEY=                 # credential, only for OpenAI-compatible servers that need it
ANONPIP_VLM_CONCURRENCY=1            # keep <= OLLAMA_NUM_PARALLEL
ANONPIP_VLM_PULL_MISSING=false       # models are downloaded by `just models`

# --- Pipeline defaults (each request may override them) ---
ANONPIP_DEFAULT_MODE=pseudonym       # pseudonym | tag | redaction
ANONPIP_DEFAULT_VERIFICATION=block   # off | report | block
ANONPIP_DEFAULT_EXTRACTION=docling   # docling | vlm (native PDF pages)
ANONPIP_DEFAULT_LAYOUT_OUTPUT=false  # also the censored PDF with the layout of the original
ANONPIP_DOCLING_MODELS_DIR=/models/docling
ANONPIP_PIPELINE_CONFIG_FILE=        # optional YAML with pipeline overrides (path inside the container)
# Optional YAML with the VLMs to download (`just models`) and the default model of each phase.
# Empty: the packaged one (resources/models.yaml). ./config is mounted on /app/config:
# put your file there (e.g. ./config/models.yaml, same schema) and set /app/config/models.yaml
ANONPIP_MODELS_FILE=
# Optional YAML with only the docling options to change (PDF parser, layout and table models,
# cell matching...). Empty: the packaged resources/docling.yaml. Same use of ./config as above.
ANONPIP_DOCLING_FILE=
# Credential: key or passphrase of the pseudonym map. Empty: every request sends its own key.
ANONPIP_VAULT_KEY=

# --- Limits and asynchronous jobs ---
ANONPIP_MAX_UPLOAD_MB=50
ANONPIP_MAX_CONCURRENT_JOBS=1        # documents processed at the same time (the GPU is the bottleneck)
ANONPIP_JOB_WAIT_S=30                # synchronous requests: wait for a slot, then 503
ANONPIP_MAX_QUEUED_JOBS=20
ANONPIP_MAX_JOBS=50
ANONPIP_JOB_TTL_S=3600
ANONPIP_ALLOW_TRANSCRIPT=true        # web UI comparison with the clear text; forced off when environment=prod
                                     # (required by `just validation`)

# --- Validation harness only (validation/, never read by the service) ---
# Credential: key sent by `just validation` for profiles with mode: pseudonym. No default.
ANONVAL_KEY=

# --- Local compose only ---
APP_PORT=8000
WEB_PORT=8080
OLLAMA_NUM_PARALLEL=1
OLLAMA_KV_CACHE_TYPE=q8_0            # f16 | q8_0 | q4_0: context memory; q4_0 for small GPUs
