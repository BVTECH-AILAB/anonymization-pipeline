# The demo page and a reverse proxy to the anonymization API, on one origin:
# the page calls relative URLs (/anonymizations/...), so no CORS is needed.
# Rendered at start by the nginx image (envsubst of the variables defined in
# the environment): WEB_PORT, API_UPSTREAM.
server {
    listen ${WEB_PORT};
    server_tokens off;

    # The API enforces ANONPIP_MAX_UPLOAD_MB (at most 200): never refuse earlier.
    client_max_body_size 210m;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    location = / {
        root /usr/share/nginx/html;
        try_files /index.html =404;
    }

    location /anonymizations {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Documents are health data: stream uploads and downloads through, so
        # nginx never writes a body to its temporary files.
        proxy_request_buffering off;
        # progress arrives as Server-Sent Events: forward every event at once
        proxy_buffering off;
        proxy_cache off;
        # an event stream stays open for the whole job; an edit redacts and verifies again
        proxy_read_timeout 1h;
    }

    # Liveness of this container; the API keeps its own probes.
    location = /healthz {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    location / {
        return 404;
    }
}
