# Task runner of the anonymization service. Run `just` here, or `just backend::<recipe>`
# from the repository root: the recipes always run in backend/.

# Reads ANONPIP_* from backend/.env: no credentials in this file.
set dotenv-load := true

default:
    @just --list

# --- Local (uv) ---

sync:
    uv sync

# Run the API on the host, with reload (needs the OCR server: `just ocr::serve` from the root)
dev:
    uv run uvicorn src.main:app --reload --port 8000

# Check the OCR server and the NER service (both must answer; nothing is downloaded)
models:
    uv run python -c "from src.config import get_settings; from src.services.anonymizer.factory import build_pipeline, load_models; import sys; sys.exit(0 if load_models(build_pipeline(get_settings().pipeline_config())) else 1)"

# --- Quality ---

format:
    uv run ruff format

fix:
    uv run ruff check --fix

types:
    uv run ty check src tests
    uv run --group evals ty check evals

# Fix, format and type-check: run before every commit
lint: fix format types

# CI mode: no fixes, fails on any finding
check:
    uv run ruff check
    uv run ruff format --check
    uv run ty check src tests
    uv run --group evals ty check evals

# --- Tests ---

# Unit tests (no network, no model weights): `just test -k edits`
test *args:
    uv run pytest {{args}}

# Unit tests with coverage (fails under 80%): coverage.xml and junit.xml for Sonar
test-cov:
    uv run pytest --cov --cov-report=term-missing --cov-report=xml:coverage.xml --junitxml=junit.xml

# Tests of the evaluation (needs the evals group: torch, scikit-learn)
evals-test *args:
    uv run --group evals pytest evals/tests {{args}}

# --- Evaluation (evals/, dev only: dataset/ and reports/ live at the repository root) ---

# NER timeout of the evaluation, above the one in .env (for the API): a slow page must not
# stop a run of hours. Change it with `EVAL_NER_TIMEOUT_SECONDS=300 just evaluate`.
eval_ner_timeout := env("EVAL_NER_TIMEOUT_SECONDS", "120")

# Needs the OCR server and NER. Example: `just evaluate --variants scan --split test --limit 20`
# Score the engine against the ground truth -> ../reports/evaluation.md
evaluate *args:
    ANONPIP_NER_TIMEOUT_SECONDS={{eval_ner_timeout}} uv run --group evals python -m evals evaluate --dataset ../dataset --out ../reports {{args}}

# Two evaluations side by side: `just eval-compare ../reports_a ../reports_b`
eval-compare *args:
    uv run --group evals python -m evals compare {{args}}

# Known vulnerabilities in the dependencies
audit:
    uv run pip-audit --skip-editable
