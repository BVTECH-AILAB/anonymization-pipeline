# Web UI: static files and proxy to the API (same origin, no CORS).
# Template: at startup the nginx image replaces ${API_UPSTREAM} (only defined environment variables,
# so nginx variables such as $uri stay as they are): http://app:8000 in compose, the API Service in
# the cluster.
server {
    listen 80;
    server_tokens off;
    root /usr/share/nginx/html;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; font-src 'self' data: blob:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'" always;

    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        client_max_body_size 101m;          # /restore receives two files of ANONPIP_MAX_UPLOAD_MB (50 MB), plus overhead
        proxy_read_timeout 900s;            # the synchronous /anonymize request can take minutes
        proxy_send_timeout 900s;
        proxy_request_buffering on;         # the API requires Content-Length
    }

    # optional locations mounted by docker compose (nginx.validation.conf, local only): in the
    # cluster the folder is empty and nothing changes
    include /etc/nginx/extra/*.conf;

    # no add_header inside the locations: nginx would no longer inherit the security headers above
    location /assets/ {
        expires 30d;                        # file names carry the content hash
        # the pdf.js worker is a .mjs module: nginx does not know the extension and would serve it as
        # application/octet-stream, which browsers refuse for modules
        location ~* \.mjs$ {
            types { }
            default_type application/javascript;
            expires 30d;
        }
    }

    # single-page application: every other path is index.html
    location / {
        try_files $uri /index.html;
        expires -1;                         # index.html always revalidated
    }
}
