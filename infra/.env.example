# Copy to infra/.env: variables of the compose file (image build, host ports).
# The settings of each service are in its own .env.example (backend/, ocr-server/),
# read by compose through env_file. Never commit .env.

# OCR_EXTRA: cpu | gpu (CUDA 12 wheels; uncomment the deploy block of paddle-ocr); empty: cpu
OCR_EXTRA=
APP_PORT=8000
OCR_PORT=8829
