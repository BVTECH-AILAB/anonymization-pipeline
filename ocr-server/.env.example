# Copy to ocr-server/.env. Read by `just serve` (OCR server on the host) and by
# docker compose (env_file). Never commit .env.

# --- OCR server (prefix OCRSRV_) ---
OCRSRV_LOG_LEVEL=INFO
OCRSRV_DEVICE=auto                   # auto | gpu | cpu
OCRSRV_DET_MODEL=PP-OCRv5_server_det # PP-OCRv5_server_det | PP-OCRv5_mobile_det
OCRSRV_MARGIN_PT=60                  # side strips read again rotated (vertical text); 0 = off
OCRSRV_MARGIN_MIN_SCORE=0.5          # margin words below this confidence are dropped
OCRSRV_MAX_UPLOAD_MB=40
OCRSRV_GPU_MEM_LIMIT_MB=0            # memory cap of each model on the GPU; 0 = none (peak about 4 GB per page)
# OCRSRV_MODEL_DIR: empty: RapidOCR cache (compose: /models/rapidocr, about 90 MB on first start)
OCRSRV_MODEL_DIR=
